#Code 9 – Part 1: Clean names, cities, missing values and IQR outliers
#1a - remove exact duplicate rows
before=len(customers)
df=customers.drop_duplicates(subset="CustomerID", keep="first").copy()
print(f"(a) Removed duplicates: {before}-> {len(df)} rows")
 
#1b - standardize inconsistent categorical text 
df["City"] = df["City"].str.strip().str.title()
print("(b) Standardized 'City' text casing:")
print(df["City"].unique())
 
#1c- Handle missing values
df["Name"]=df["Name"].fillna("Unknown")
df["Age"]=df["Age"].fillna(df["Age"].median())
df["Salary"]=df["Salary"].fillna(df["Salary"].median())
print("\n(c) Missing values after imputation:")
print(df.isnull().sum())
 
#1d- Handle outliers using IQR method
def cap_outliers_iqr(series):
    q1,q3=series.quantile([0.25, 0.75])
    iqr=q3-q1
    lower, upper= q1-1.5*iqr, q3+1.5*iqr
    return series.clip(lower, upper)
 
print("\n(d) Outlier capping (IQR method) on Age and Salary:")
print("Before->", df[["Age", "Salary"]].describe().loc[["min","max"]].to_dict())
df["Age"]=cap_outliers_iqr(df["Age"])
df["Salary"]=cap_outliers_iqr(df["Salary"])
print("After ->", df[["Age", "Salary"]].describe().loc[["min","max"]].to_dict())
 
print("\nCleaned dataset:")
